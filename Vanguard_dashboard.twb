    <worksheet name='Time of day vs completion'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Does Time of Day Affect Completion</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='web_with_errors+' name='federated.1cmmgdj0b5gy7g1297fxx0ok1t71' />
          </datasources>
          <datasource-dependencies datasource='federated.1cmmgdj0b5gy7g1297fxx0ok1t71'>
            <column caption='Completed' datatype='integer' name='[Calculation_0025024591163401]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [process_step] = &quot;confirm&quot; THEN 1 ELSE 0 END' />
            </column>
            <column caption='Time of day' datatype='string' name='[Calculation_0025024596570123]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEPART(&apos;hour&apos;, [date_time]) &lt; 12 THEN &quot;Morning&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;, [date_time]) &lt; 18 THEN &quot;Afternoon&quot;&#13;&#10;ELSE &quot;Evening&quot;&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Variation]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0025024591163401]' derivation='Avg' name='[avg:Calculation_0025024591163401:qk]' pivot='key' type='quantitative' />
