      <aliases enabled='yes' />
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([process_step]) / TOTAL(COUNT([process_step]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Completed' datatype='integer' name='[Calculation_0025024569913344]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [process_step] = &quot;confirm&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Is Last Step Confirm' datatype='integer' default-format='p0%' name='[Calculation_0025024571920387]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [visit_id] : MAX(IF [process_step] = &quot;confirm&quot; THEN 1 ELSE 0 END) }' />
      </column>
      <column caption='Step error' datatype='integer' name='[Calculation_0025024575029252]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [process_step] = &quot;start&quot; THEN 0&#13;&#10;ELSEIF [process_step] = &quot;step_1&quot; THEN 1&#13;&#10;ELSEIF [process_step] = &quot;step_2&quot; THEN 2&#13;&#10;ELSEIF [process_step] = &quot;step_3&quot; THEN 3&#13;&#10;ELSEIF [process_step] = &quot;confirm&quot; THEN 4&#13;&#10;END' />
      </column>
      <column caption='error rate' datatype='real' name='[Calculation_0025024585420808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [process_step] = &quot;start&quot; THEN [visit_id] END) /&#13;&#10;COUNTD([visit_id])' />
      </column>
      <column caption='Is_step_one' datatype='boolean' name='[Calculation_0025024598921229]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[process_step] = &quot;step_1&quot;' />
      </column>
